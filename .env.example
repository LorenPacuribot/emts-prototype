# Live supplier API access is disabled until a password of at least 24 characters is set.
# Use a private server environment variable; never prefix this with NEXT_PUBLIC_.
SUPPLIER_ADMIN_PASSWORD=

# Live supplier API/EDI connection (feature 19). Server-side only — never
# prefix these with NEXT_PUBLIC_. The app shows whether each is set, never the value.
# To try the live path in development, use the built-in mock supplier:
SUPPLIER_SUP_SW_ENDPOINT_URL=http://localhost:3000/api/mock-supplier
SUPPLIER_SUP_SW_API_KEY=replace-with-a-long-random-string
# Shared secret used to sign POST /api/suppliers/SUP-SW/webhook:
# X-Supplier-Signature: sha256=<HMAC-SHA256 hex of the raw body>
SUPPLIER_SUP_SW_WEBHOOK_SECRET=replace-with-another-long-random-string
