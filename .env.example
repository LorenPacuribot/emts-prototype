# Live supplier API/EDI connection (feature 19). Server-side only — never
# prefix these with NEXT_PUBLIC_. The app shows whether each is set, never the value.
#
# To try the live path end to end in development, point the endpoint at the
# built-in mock supplier (not a real supplier):
SUPPLIER_SUP_SW_ENDPOINT_URL=http://localhost:3000/api/mock-supplier
SUPPLIER_SUP_SW_API_KEY=replace-with-a-long-random-string
# Shared secret the supplier uses to sign webhook calls:
#   POST /api/suppliers/SUP-SW/webhook   header X-Supplier-Signature: sha256=<HMAC-SHA256 hex of the raw body>
SUPPLIER_SUP_SW_WEBHOOK_SECRET=replace-with-another-long-random-string
